{
  "name": "grimoire",
  "version": "0.1.0",
  "description": "オラクルちゃんと呪いの本",
  "main": "./out/main/index.js",
  "author": "jyllsarta.net",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run --exclude \"test/**/*.fuzz.test.js\"",
    "test:fuzz": "vitest run fuzz.test",
    "test:full": "vitest run",
    "selftest": "node tools/selftest.js",
    "import": "node tools/import.js",
    "schema": "node tools/gen_schema.js",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:debug": "node scripts/run-platform-script.cjs dev:debug",
    "dev:debug:mac": "REMOTE_DEBUGGING_PORT=9222 electron-vite dev",
    "dev:debug:win": "set \"REMOTE_DEBUGGING_PORT=9222\" && electron-vite dev",
    "dev:trial": "node scripts/run-platform-script.cjs dev:trial",
    "dev:trial:mac": "EDITION=trial electron-vite dev",
    "dev:trial:win": "set \"EDITION=trial\" && electron-vite dev",
    "dev:cien": "node scripts/run-platform-script.cjs dev:cien",
    "dev:cien:mac": "EDITION=cien electron-vite dev",
    "dev:cien:win": "set \"EDITION=cien\" && electron-vite dev",
    "dev:steam": "node scripts/run-platform-script.cjs dev:steam",
    "dev:steam:mac": "EDITION=steam electron-vite dev",
    "dev:steam:win": "set \"EDITION=steam\" && electron-vite dev",
    "dev:steam:clean": "node scripts/run-platform-script.cjs dev:steam:clean",
    "dev:steam:clean:mac": "EDITION=steam_clean electron-vite dev",
    "dev:steam:clean:win": "set \"EDITION=steam_clean\" && electron-vite dev",
    "build": "electron-vite build",
    "build:trial": "node scripts/run-platform-script.cjs build:trial",
    "build:trial:mac": "EDITION=trial electron-vite build",
    "build:trial:win": "set \"EDITION=trial\" && electron-vite build",
    "build:cien": "node scripts/run-platform-script.cjs build:cien",
    "build:cien:mac": "EDITION=cien electron-vite build",
    "build:cien:win": "set \"EDITION=cien\" && electron-vite build",
    "build:steam": "node scripts/run-platform-script.cjs build:steam",
    "build:steam:mac": "EDITION=steam electron-vite build",
    "build:steam:win": "set \"EDITION=steam\" && electron-vite build",
    "build:steam:clean": "node scripts/run-platform-script.cjs build:steam:clean",
    "build:steam:clean:mac": "EDITION=steam_clean electron-vite build",
    "build:steam:clean:win": "set \"EDITION=steam_clean\" && electron-vite build",
    "build:web:trial": "node scripts/run-platform-script.cjs build:web:trial",
    "build:web:trial:mac": "EDITION=web_trial electron-vite build",
    "build:web:trial:win": "set \"EDITION=web_trial\" && electron-vite build",
    "build:web:cien": "node scripts/run-platform-script.cjs build:web:cien",
    "build:web:cien:mac": "EDITION=cien_web electron-vite build",
    "build:web:cien:win": "set \"EDITION=cien_web\" && electron-vite build",
    "build:web:android": "node scripts/run-platform-script.cjs build:web:android",
    "build:web:android:mac": "EDITION=android electron-vite build",
    "build:web:android:win": "set \"EDITION=android\" && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win:trial": "npm run build:trial && electron-builder --win",
    "build:win:cien": "npm run build:cien && electron-builder --win",
    "build:win:steam": "npm run build:steam && electron-builder --win",
    "build:win:steam:clean": "npm run build:steam:clean && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "pinia": "^4.0.3",
    "prettier": "^3.9.8",
    "sass-embedded": "^1.104.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1"
  }
}
